// Border setup na ninakaw ko sa gawa ni Victor.
void gotoxy(int x, int y)
{
    COORD coord;
    coord.X = x;
    coord.Y = y;
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), coord);
}

void ClearLine(int x, int y, int length)
{
    gotoxy(x, y);
    std::cout << std::string(length, ' '); // overwrite with spaces
}

void Border(int left, int top, int width, int height)
{
    // Draw corners
    gotoxy(left, top);
    std::cout << "O";
    gotoxy(left + width, top);
    std::cout << "O";
    gotoxy(left, top + height);
    std::cout << "O";
    gotoxy(left + width, top + height);
    std::cout << "O";

    // Draw top and bottom edges
    for (int x = left + 1; x < left + width; x++)
    {
        gotoxy(x, top);
        std::cout << "-";
        gotoxy(x, top + height);
        std::cout << "-";
    }

    // Draw left and right edges
    for (int y = top + 1; y < top + height; y++)
    {
        gotoxy(left, y);
        std::cout << "|";
        gotoxy(left + width, y);
        std::cout << "|";
    }
}



